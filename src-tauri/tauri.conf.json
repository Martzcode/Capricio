{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Capricio",
  "version": "2026.10.1",
  "identifier": "com.capricio.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/capricio/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Capricio",
        "width": 900,
        "height": 680,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Martzcode",
    "category": "Utility",
    "shortDescription": "Aide à la décision rapide, 100 % hors-ligne",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
